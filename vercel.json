{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/anketa.html",
      "destination": "/anketa.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!anketa\\.html|assets/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
